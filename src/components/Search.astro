---
const baseUrl = import.meta.env.BASE_URL;
// Ensure baseUrl has a trailing slash for concatenation
const basePath = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
---

<div class="search-wrapper" id="search-wrapper">
  <div id="search"></div>
</div>

<link rel="stylesheet" href={`${basePath}pagefind/pagefind-ui.css`} />

<script is:inline define:vars={{ basePath }}>
  window.addEventListener('DOMContentLoaded', () => {
    // Only initialize if pagefind assets exist (post-build)
    const script = document.createElement('script');
    script.src = basePath + 'pagefind/pagefind-ui.js';
    script.onload = () => {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        baseUrl: basePath
      });
    };
    script.onerror = () => {
      document.getElementById('search').innerHTML =
        '<p class="meta" style="padding: 1rem;">Search is available after building the site. Run <code>npm run build</code> to enable search.</p>';
    };
    document.head.appendChild(script);
  });
</script>
