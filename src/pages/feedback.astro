---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Feedback and Suggestions" description="Share corrections, suggestions, and questions about the archive.">
  <div class="container page-pad">
    <h1>Feedback and Suggestions</h1>
    <p>This archive is continuously improving. If you have suggestions for the site, corrections to Sanskrit citations, questions about how to use the archive, or requests for additional features, please share them below.</p>

    <div class="form-placeholder">
      <!-- REPLACE THIS URL WITH YOUR GOOGLE FORM EMBED URL -->
      <iframe src="YOUR_GOOGLE_FORM_EMBED_URL"
              width="100%" height="800"
              frameborder="0" marginheight="0" marginwidth="0">
        Loading form...
      </iframe>
    </div>

    <p>Alternatively, email directly: <a href="mailto:nistala.aditya@gmail.com?subject=Vedantic%20Archive%20%E2%80%94%20%5Byour%20topic%5D">nistala.aditya@gmail.com</a> with subject line <strong>Vedāntic Archive — [your topic]</strong>.</p>
  </div>
</BaseLayout>
