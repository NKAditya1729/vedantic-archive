<p style="margin:0.0px 0.0px 16.0px 0.0px; color:#1a1a1a; font-size:16.0px"><b>idaṃ</b><span style="font-size:16.0px"><b> </b></span><b>satyaṃ</b><span style="font-size:16.0px"><b> </b></span><b>sarveṣāṃ</b><span style="font-size:16.0px"><b> </b></span><b>bhūtānāṃ</b><span style="font-size:16.0px"><b> </b></span><b>madhvasya</b><span style="font-size:16.0px"><b> </b></span><b>satyasya</b><span style="font-size:16.0px"><b> </b></span><b>sarvāṇi</b><span style="font-size:16.0px"><b> </b></span><b>bhūtāni</b><span style="font-size:16.0px"><b> </b></span><b>madhu</b><span style="font-size:16.0px"><b> </b></span><b>yaścāyamasminsatye</b><span style="font-size:16.0px"><b> </b></span><b>tejomayo'mṛtamayaḥ</b><span style="font-size:16.0px"><b> </b></span><b>puruṣo</b><span style="font-size:16.0px"><b> </b></span><b>yaścāyamadhyātmaṃ</b><span style="font-size:16.0px"><b> </b></span><b>sātyastejomayo'mṛtamayaḥ</b><span style="font-size:16.0px"><b> </b></span><b>puruṣo'yameva</b><span style="font-size:16.0px"><b> </b></span><b>sa</b><span style="font-size:16.0px"><b> </b></span><b>yo'yamātmedamamṛtamidaṃ</b><span style="font-size:16.0px"><b> </b></span><b>brahmedaṃ</b><span style="font-size:16.0px"><b> </b></span><b>sarvam</b><span style="font-size:16.0px"><b> </b></span><b>॥</b><span style="font-size:16.0px"><b> 2-5-12 </b></span><b>॥</b><b></b></p>
<p style="margin:0.0px 0.0px 0.0px 0.0px; color:#1a1a1a; font-size:16.0px">tathā<span style="font-size:16.0px"> </span>dṛṣṭenānuṣṭhīyamānena<span style="font-size:16.0px"> </span>ācārarūpeṇa<span style="font-size:16.0px"> </span>satyākhyo<span style="font-size:16.0px"> </span>bhavati<span style="font-size:16.0px">, </span>sa<span style="font-size:16.0px"> </span>eva<span style="font-size:16.0px"> </span>dharmaḥ<span style="font-size:16.0px"> ; </span>so'pi<span style="font-size:16.0px"> </span>dviprakāra<span style="font-size:16.0px"> </span>eva<span style="font-size:16.0px"> </span>sāmānyaviśeṣātmarūpeṇa<span style="font-size:16.0px"> — </span>sāmānyarūpaḥ<span style="font-size:16.0px"> </span>pṛthivyādisamavetaḥ<span style="font-size:16.0px">, </span>viśeṣarūpaḥ<span style="font-size:16.0px"> </span>kāryakaraṇasaṅghātasamavetaḥ<span style="font-size:16.0px"> ; </span>tatra<span style="font-size:16.0px"> </span>pṛthivyādisamavete<span style="font-size:16.0px"> </span>vartamānakriyārūpe<span style="font-size:16.0px"> </span><span style="color:#b54510; text-decoration:underline"><b>satye</b></span><span style="font-size:16.0px">, </span>tathā<span style="font-size:16.0px"> </span><span style="color:#b54510; text-decoration:underline"><b>adhyātmaṃ</b></span><span style="font-size:16.0px"> </span>kāryakaraṇasaṅghātasamavete<span style="font-size:16.0px"> </span>satye<span style="font-size:16.0px">, </span>bhavaḥ<span style="font-size:16.0px"> </span><span style="color:#b54510; text-decoration:underline"><b>sātyaḥ</b></span><span style="font-size:16.0px"> — ‘</span>satyena<span style="font-size:16.0px"> </span>vāyurāvāti<span style="font-size:16.0px">’ (</span>tai<span style="font-size:16.0px">. </span>nā<span style="font-size:16.0px">. </span>2<span style="font-size:16.0px"> </span>|<span style="font-size:16.0px"> </span>1<span style="font-size:16.0px">) </span>iti<span style="font-size:16.0px"> </span>śrutyantarāt<span style="font-size:16.0px"> </span>॥</p>
