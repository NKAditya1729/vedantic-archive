n><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">५</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">।</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">१०</span><span style="color:#0000ff; text-decoration:underline">)</span></a> <a style="color:inherit" href="https://advaitasharada.sringeri.net/display/bhashya/Gita/devanagari?page=13&amp;id=BG_C13_V27&amp;hl=%E0%A4%B8%E0%A4%AE%E0%A4%82%20%E0%A4%B8%E0%A4%B0%E0%A5%8D%E0%A4%B5%E0%A5%87%E0%A4%B7%E0%A5%81%20%E0%A4%AD%E0%A5%82%E0%A4%A4%E0%A5%87%E0%A4%B7%E0%A5%81"><span style="color:#0000ff; text-decoration:underline">‘</span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">समं</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">सर्वेषु</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">भूतेषु</span><span style="color:#0000ff; text-decoration:underline">’ (</span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">भ</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">गी</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">१३</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">।</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">२७</span><span style="color:#0000ff; text-decoration:underline">)</span></a> <a style="color:inherit" href="https://advaitasharada.sringeri.net/display/bhashya/Gita/devanagari?page=17&amp;id=BG_C17_V20&amp;hl=%E0%A4%85%E0%A4%B5%E0%A4%BF%E0%A4%AD%E0%A4%95%E0%A5%8D%E0%A4%A4%E0%A4%82%20%E0%A4%B5%E0%A4%BF%E0%A4%AD%E0%A4%95%E0%A5%8D%E0%A4%A4%E0%A5%87%E0%A4%B7%E0%A5%81"><span style="color:#0000ff; text-decoration:underline">‘</span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">अविभक्तं</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">विभक्तेषु</span><span style="color:#0000ff; text-decoration:underline">’ (</span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">भ</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">गी</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">१७</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">।</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">२०</span><span style="color:#0000ff; text-decoration:underline">)</span></a> <a style="color:inherit" href="https://advaitasharada.sringeri.net/display/bhashya/Gita/devanagari?page=13&amp;id=BG_C13_V16&amp;hl=%E0%A4%97%E0%A5%8D%E0%A4%B0%E0%A4%B8%E0%A4%BF%E0%A4%B7%E0%A5%8D%E0%A4%A3%E0%A5%81%20%E0%A4%AA%E0%A5%8D%E0%A4%B0%E0%A4%AD%E0%A4%B5%E0%A4%BF%E0%A4%B7%E0%A5%8D%E0%A4%A3%E0%A5%81%20%E0%A4%9A"><span style="color:#0000ff; text-decoration:underline">‘</span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">ग्रसिष्णु</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">प्रभविष्णु</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">च</span><span style="color:#0000ff; text-decoration:underline">’ (</span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">भ</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">गी</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">१३</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">।</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">१६</span><span style="color:#0000ff; text-decoration:underline">)</span></a> </span>इति<span style="font-size:16.0px"> — </span>एवमाद्यागमार्थं<span style="font-size:16.0px"> </span>विरुद्धमिव<span style="font-size:16.0px"> </span>प्रतिभान्तं<span style="font-size:16.0px"> </span>मन्यमानाः<span style="font-size:16.0px"> </span>स्वचित्तसामर्थ्यात्<span style="font-size:16.0px"> </span>अर्थनिर्णयाय<span style="font-size:16.0px"> </span>विकल्पयन्तः<span style="font-size:16.0px"> — </span>अस्त्यात्मा<span style="font-size:16.0px"> </span>नास्त्यात्मा<span style="font-size:16.0px">, </span>कर्ता<span style="font-size:16.0px"> </span>अकर्ता<span style="font-size:16.0px">, </span>मुक्तः<span style="font-size:16.0px"> </span>बद्धः<span style="font-size:16.0px">, </span>क्षणिको<span style="font-size:16.0px"> </span>विज्ञानमात्रं<span style="font-size:16.0px"> </span>शून्यं<span style="font-size:16.0px"> </span>च<span style="font-size:16.0px"> — </span>इत्येवं<span style="font-size:16.0px"> </span>विकल्पयन्तः<span style="font-size:16.0px"> </span>न<span style="font-size:16.0px"> </span>पारमधिगच्छन्त्यविद्यायाः<span style="font-size:16.0px">, </span>विरुद्धधर्मदर्शित्वात्सर्वत्र<span style="font-size:16.0px"> </span>।<span style="font-size:16.0px"> </span>तस्मात्<span style="font-size:16.0px"> </span>तत्र<span style="font-size:16.0px"> </span>य<span style="font-size:16.0px"> </span>एव<span style="font-size:16.0px"> </span>श्रुत्याचार्यदर्शितमार्गानुसारिणः<span style="font-size:16.0px">, </span>त<span style="font-size:16.0px"> </span>एवाविद्यायाः<span style="font-size:16.0px"> </span>पारमधिगच्छन्ति<span style="font-size:16.0px"> ; </span>त<span style="font-size:16.0px"> </span>एव<span style="font-size:16.0px"> </span>च<span style="font-size:16.0px"> </span>अस्मान्मोहसमुद्रादगाधात्<span style="font-size:16.0px"> </span>उत्तरिष्यन्ति<span style="font-size:16.0px">, </span>नेतरे<span style="font-size:16.0px"> </span>स्वबुद्धिकौशलानुसारिणः<span style="font-size:16.0px"> </span>॥</p>
<p style="margin:0.0px 0.0px 0.0px 0.0px; color:#1a1a1a; font-size:16.0px">परिसमाप्ता<span style="font-size:16.0px"> </span>ब्रह्मविद्या<span style="font-size:16.0px"> </span>अमृतत्व<span style="font-size:16.0px">-</span>साधनभूता<span style="font-size:16.0px">, </span>यां<span style="font-size:16.0px"> </span>मैत्रेयी<span style="font-size:16.0px"> </span>पृष्टवती<span style="font-size:16.0px"> </span>भर्तारम्<span style="font-size:16.0px"> <a style="color:inherit" href="https://advaitasharada.sringeri.net/display/bhashya/Brha/devanagari?page=2&amp;id=BR_C02_S04_V03&amp;hl=%E0%A4%AF%E0%A4%A6%E0%A5%87%E0%A4%B5%20%E0%A4%AD%E0%A4%97%E0%A4%B5%E0%A4%BE%E0%A4%A8%E0%A4%AE%E0%A5%83%E0%A4%A4%E0%A4%A4%E0%A5%8D%E0%A4%B5%E0%A4%B8%E0%A4%BE%E0%A4%A7%E0%A4%A8%E0%A4%82%20%E0%A4%B5%E0%A5%87%E0%A4%A6%20%E0%A4%A4%E0%A4%A6%E0%A5%87%E0%A4%B5%20%E0%A4%AE%E0%A5%87%20%E0%A4%AC%E0%A5%8D%E0%A4%B0%E0%A5%82%E0%A4%B9%E0%A4%BF"><span style="color:#0000ff; text-decoration:underline">‘</span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">यदेव</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">भगवानमृतत्वसाधनं</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">वेद</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">तदेव</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">मे</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">ब्रूहि</span><span style="color:#0000ff; text-decoration:underline">’ (</span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">बृ</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">उ</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">२</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">।</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">४</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">।</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">३</span><span style="color:#0000ff; text-decoration:underline">)</span></a> </span>इति<span style="font-size:16.0px"> </span>।<span style="font-size:16.0px"> </span>एतस्या<span style="font-size:16.0px"> </span>ब्रह्मविद्यायाः<span style="font-size:16.0px"> </span>स्तुत्यर्था<span style="font-size:16.0px"> </span>इयमाख्यायिका<span style="font-size:16.0px"> </span>आनीता<span style="font-size:16.0px"> </span>।<span style="font-size:16.0px"> </span>तस्या<span style="font-size:16.0px"> </span>आख्यायिकायाः<span style="font-size:16.0px"> </span>सङ्क्षेपतोऽर्थप्रकाशनार्थावेतौ<span style="font-size:16.0px"> </span>मन्त्रौ<span style="font-size:16.0px"> </span>भवतः<span style="font-size:16.0px"> ; </span>एवं<span style="font-size:16.0px"> </span>हि<span style="font-size:16.0px"> </span>मन्त्रब्राह्मणाभ्यां<span style="font-size:16.0px"> </span>स्तुतत्वात्<span style="font-size:16.0px"> </span>अमृतत्वसर्वप्राप्तिसाधनत्वं<span style="font-size:16.0px"> </span>ब्रह्मविद्यायाः<span style="font-size:16.0px"> </span>प्रकटीकृतं<span style="font-size:16.0px"> </span>राजमार्गमुपनीतं<span style="font-size:16.0px"> </span>भवति<span style="font-size:16.0px"> — </span>यथा<span style="font-size:16.0px"> </span>आदित्य<span style="font-size:16.0px"> </span>उद्यन्<span style="font-size:16.0px"> </span>शार्वरं<span style="font-size:16.0px"> </span>तमोऽपनयतीति<span style="font-size:16.0px"> — </span>तद्वत्<span style="font-size:16.0px"> </span>।</p>
