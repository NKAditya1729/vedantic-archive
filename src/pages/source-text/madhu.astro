<p style="margin:0.0px 0.0px 0.0px 0.0px; color:#1a1a1a; font-size:16.0px"><span style="font-size:16.0px"> </span>yaduktam<span style="font-size:16.0px"> , </span>brahmavit<span style="font-size:16.0px"> </span>vāmadevaḥ<span style="font-size:16.0px"> </span>pratipede<span style="font-size:16.0px"> — </span>ahaṃ<span style="font-size:16.0px"> </span>manurabhavaṃ<span style="font-size:16.0px"> </span>sūryaśceti<span style="font-size:16.0px"> (<a style="color:inherit" href="https://advaitasharada.sringeri.net/display/bhashya/Brha/devanagari?page=2&amp;id=BR_C01_S04_V10&amp;hl=%E0%A4%85%E0%A4%B9%E0%A4%82%20%E0%A4%AE%E0%A4%A8%E0%A5%81%E0%A4%B0%E0%A4%AD%E0%A4%B5%E0%A4%82%20%E0%A4%B8%E0%A5%82%E0%A4%B0%E0%A5%8D%E0%A4%AF%E0%A4%B6%E0%A5%8D%E0%A4%9A"><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">bṛ</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">u</span><span style="color:#0000ff; text-decoration:underline">. </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">1</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">|</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">4</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">|</span><span style="color:#0000ff; text-decoration:underline"> </span><span style="color:#0000ff; font-size:16.0px; text-decoration:underline">10</span></a>), </span>sa<span style="font-size:16.0px"> </span>eṣa<span style="font-size:16.0px"> </span>sarvātmabhāvo<span style="font-size:16.0px"> </span>vyākhyātaḥ<span style="font-size:16.0px"> </span>|<span style="font-size:16.0px"> </span>sa<span style="font-size:16.0px"> </span>eṣa<span style="font-