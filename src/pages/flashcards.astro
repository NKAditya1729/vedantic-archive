---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// Read the pre-assembled rich glossary data from the repository content folder
const glossaryPath = path.resolve('./src/content/glossary/assembled_glossary.json');
const rawGlossary = fs.readFileSync(glossaryPath, 'utf-8');
const glossarySections = JSON.parse(rawGlossary);

// Get all class metadata to pull dates dynamically
const allClasses = await getCollection('classes');
const classDates = {};
allClasses.forEach(c => {
  if (c.data.script === 'iast') {
    classDates[c.data.class_number] = c.data.date;
  }
});

// Separate into class sections and the consolidated core section
const classSections = glossarySections.filter(s => s.classNumber !== null);
const coreSection = glossarySections.find(s => s.classNumber === null);

// Most recent class is expanded by default; older classes start collapsed
const maxClassNumber = classSections.length
  ? Math.max(...classSections.map(s => s.classNumber))
  : 0;

// Generate flat list of all terms for the index cloud, sorted alphabetically by IAST
const allIndexTerms = glossarySections
  .flatMap(section => 
    section.terms.map(term => ({
      deva: term.deva,
      iast: term.iast,
      slug: `term-${section.classNumber || 'core'}-${term.iast.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
      classNumber: section.classNumber
    }))
  )
  .sort((a, b) => a.iast.localeCompare(b.iast));

function getTermSlug(termIast: string, classNum: number | null) {
  return `term-${classNum || 'core'}-${termIast.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
}
---

<BaseLayout title="Flashcards" description="A comprehensive classwise and consolidated set of flashcards for Maitreyī Brāhmaṇa study.">
  <!-- Run inline script block as early as possible to prevent flash of wrong script -->
  <script is:inline>
    (function() {
      const savedScript = localStorage.getItem('vedantic_archive_glossary_script') || 'deva';
      document.documentElement.setAttribute('data-script', savedScript);
    })();
  </script>

  <div class="container container--wide page-pad">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/vedantic-archive/">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">›</span>
      <span class="breadcrumb__current" aria-current="page">Flashcards</span>
    </nav>

    <header class="glossary-header">
      <h1>Flashcards</h1>
      <p class="meta">A curated set of flashcards covering Sanskrit terminology from the Maitreyī Brāhmaṇa classes (Bṛhadāraṇyaka Upaniṣad 2.4).</p>
    </header>

    <!-- Sticky Translucent Controls Panel -->
    <div class="glossary-controls-sticky">
      <div class="search-wrapper">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input 
          type="text" 
          id="glossary-search" 
          class="search-input" 
          placeholder="Search by English, IAST, or Devanagari..." 
          aria-label="Search flashcards"
        />
        <button id="glossary-search-clear" class="search-clear" aria-label="Clear search" style="display: none;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <div class="controls-right">
        <span class="matching-count" id="matching-count-val">{allIndexTerms.length} of {allIndexTerms.length} matching</span>
        
        <div class="script-toggle-segmented" role="radiogroup" aria-label="Sanskrit script selection">
          <button id="toggle-script-deva" class="script-toggle-btn active" role="radio" aria-checked="true">देवनागरी</button>
          <button id="toggle-script-iast" class="script-toggle-btn" role="radio" aria-checked="false">IAST</button>
        </div>
      </div>
    </div>

    <!-- Collapsible Index Pill Cloud -->
    <details class="glossary-index-container">
      <summary>
        <span class="summary-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M3 20v-8c0-2.2 1.8-4 4-4h10c2.2 0 4 1.8 4 4v8"></path>
            <circle cx="7" cy="12" r="1"></circle>
            <circle cx="17" cy="12" r="1"></circle>
            <path d="M12 8V5c0-1.7-1.3-3-3-3S6 3.3 6 5"></path>
          </svg>
          Browse Alphabetical Index ({allIndexTerms.length} terms)
        </span>
        <svg class="details-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <div class="index-content">
        <div class="glossary-index-cloud">
          {allIndexTerms.map(item => (
            <a href={`#${item.slug}`} class="glossary-index-link">
              <span class="deva-only">{item.deva}</span>
              <span class="iast-only">{item.iast}</span>
            </a>
          ))}
        </div>
      </div>
    </details>

    <!-- Main Cards Section -->
    <div class="glossary-sections-container">
      {classSections.map(section => (
        <details
          class="glossary-section class-accordion"
          id={`class-section-${section.classNumber}`}
          open={section.classNumber === maxClassNumber}
          data-default-open={section.classNumber === maxClassNumber ? '' : undefined}
        >
          <summary class="class-accordion__header">
            <span class="accordion-class">Class {section.classNumber}</span>
            <span class="accordion-title">{section.sectionTitle}</span>
            {classDates[section.classNumber] && <span class="section-date">({classDates[section.classNumber]})</span>}
            <span class="term-count">{section.terms.length} terms</span>
          </summary>

          <div class="class-accordion__body">
          <div class="cards-grid">
            {section.terms.map(term => (
              <article 
                class="glossary-card" 
                id={getTermSlug(term.iast, section.classNumber)}
                data-search-deva={term.search_deva}
                data-search-iast={term.search_iast}
              >
                <h3 class="card-word">
                  <span class="deva-only">{term.deva}</span>
                  <span class="iast-only">{term.iast}</span>
                </h3>

                {(term.breakdown_deva || term.breakdown_iast) && (
                  <div class="card-breakdown">
                    <span class="deva-only">— {term.breakdown_deva}</span>
                    <span class="iast-only">— {term.breakdown_iast}</span>
                  </div>
                )}

                {term.phrasal && (
                  <div class="card-phrasal">
                    {term.phrasal}
                  </div>
                )}

                {term.source && (
                  <div class="card-source">
                    Source:
                    <span class="deva-only" set:html={term.source} />
                    <span class="iast-only" set:html={term.source_iast || term.source} />
                  </div>
                )}

                <div class="card-body">
                  <p class="card-text">
                    <strong>Definition.</strong> <span set:html={term.definition}></span>
                  </p>
                  
                  {term.context && (
                    <p class="card-text">
                      <strong>Swamiji's Contextual Explanation.</strong> <span set:html={term.context}></span>
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
          </div>
        </details>
      ))}

      {coreSection && coreSection.terms.length > 0 && (
        <details class="glossary-section class-accordion" id="class-section-core">
          <summary class="class-accordion__header">
            <span class="accordion-class">Core</span>
            <span class="accordion-title">{coreSection.sectionTitle}</span>
            <span class="term-count">{coreSection.terms.length} terms</span>
          </summary>

          <div class="class-accordion__body">
          <div class="cards-grid">
            {coreSection.terms.map(term => (
              <article 
                class="glossary-card" 
                id={getTermSlug(term.iast, null)}
                data-search-deva={term.search_deva}
                data-search-iast={term.search_iast}
              >
                <h3 class="card-word">
                  <span class="deva-only">{term.deva}</span>
                  <span class="iast-only">{term.iast}</span>
                </h3>

                {(term.breakdown_deva || term.breakdown_iast) && (
                  <div class="card-breakdown">
                    <span class="deva-only">— {term.breakdown_deva}</span>
                    <span class="iast-only">— {term.breakdown_iast}</span>
                  </div>
                )}

                {term.phrasal && (
                  <div class="card-phrasal">
                    {term.phrasal}
                  </div>
                )}

                {term.source && (
                  <div class="card-source">
                    Source:
                    <span class="deva-only" set:html={term.source} />
                    <span class="iast-only" set:html={term.source_iast || term.source} />
                  </div>
                )}

                <div class="card-body">
                  <p class="card-text">
                    <strong>Definition.</strong> <span set:html={term.definition}></span>
                  </p>
                  
                  {term.context && (
                    <p class="card-text">
                      <strong>Swamiji's Contextual Explanation.</strong> <span set:html={term.context}></span>
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
          </div>
        </details>
      )}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('glossary-search');
    const searchClear = document.getElementById('glossary-search-clear');
    const matchingCount = document.getElementById('matching-count-val');
    const cards = document.querySelectorAll('.glossary-card');
    const indexLinks = document.querySelectorAll('.glossary-index-link');
    const sections = document.querySelectorAll('.glossary-section');
    const indexContainer = document.querySelector('.glossary-index-container');
    
    // Segmented toggle controls
    const toggleDeva = document.getElementById('toggle-script-deva');
    const toggleIast = document.getElementById('toggle-script-iast');
    
    // Function to normalise strings for search
    function normalizeStr(str) {
      if (!str) return '';
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '') // remove combining diacritics
        .replace(/ā/g, 'a')
        .replace(/ī/g, 'i')
        .replace(/ū/g, 'u')
        .replace(/ṛ/g, 'r')
        .replace(/ṝ/g, 'r')
        .replace(/ḷ/g, 'l')
        .replace(/ṅ/g, 'n')
        .replace(/ñ/g, 'n')
        .replace(/ṭ/g, 't')
        .replace(/ḍ/g, 'd')
        .replace(/ṇ/g, 'n')
        .replace(/ś/g, 's')
        .replace(/ṣ/g, 's')
        .replace(/ṃ/g, 'm')
        .replace(/ḥ/g, 'h')
        .replace(/[^a-z0-9\s\u0900-\u097F]/g, ''); // retain Devanagari range but strip punctuation
    }

    // Toggle Script
    function setScript(script) {
      document.documentElement.setAttribute('data-script', script);
      localStorage.setItem('vedantic_archive_glossary_script', script);
      
      if (script === 'deva') {
        toggleDeva.classList.add('active');
        toggleDeva.setAttribute('aria-checked', 'true');
        toggleIast.classList.remove('active');
        toggleIast.setAttribute('aria-checked', 'false');
      } else {
        toggleIast.classList.add('active');
        toggleIast.setAttribute('aria-checked', 'true');
        toggleDeva.classList.remove('active');
        toggleDeva.setAttribute('aria-checked', 'false');
      }
    }
    
    // Read initial script
    const initialScript = localStorage.getItem('vedantic_archive_glossary_script') || 'deva';
    setScript(initialScript);
    
    toggleDeva.addEventListener('click', () => setScript('deva'));
    toggleIast.addEventListener('click', () => setScript('iast'));
    
    // Search function
    function runSearch() {
      const rawQuery = searchInput.value;
      const query = normalizeStr(rawQuery);
      
      if (rawQuery.length > 0) {
        searchClear.style.display = 'flex';
      } else {
        searchClear.style.display = 'none';
      }
      
      let matchCount = 0;
      
      sections.forEach(section => {
        let sectionMatches = 0;
        const sectionCards = section.querySelectorAll('.glossary-card');
        
        sectionCards.forEach(card => {
          const devaSearch = card.getAttribute('data-search-deva') || '';
          const iastSearch = card.getAttribute('data-search-iast') || '';
          
          const isMatch = devaSearch.includes(query) || iastSearch.includes(query);
          
          if (isMatch) {
            card.style.display = 'block';
            sectionMatches++;
            matchCount++;
            
            // Show corresponding index link
            const termId = card.id;
            const link = document.querySelector(`.glossary-index-link[href="#${termId}"]`);
            if (link) link.style.display = 'inline-flex';
          } else {
            card.style.display = 'none';
            
            // Hide corresponding index link
            const termId = card.id;
            const link = document.querySelector(`.glossary-index-link[href="#${termId}"]`);
            if (link) link.style.display = 'none';
          }
        });
        
        if (sectionMatches > 0) {
          section.style.display = 'block';
        } else {
          section.style.display = 'none';
        }

        // Accordion behaviour: while searching, expand every section that has
        // matches so the cards are visible; when the query is cleared, restore
        // the default (only the most recent class open).
        if (section.tagName === 'DETAILS') {
          if (rawQuery.length > 0) {
            section.open = sectionMatches > 0;
          } else {
            section.open = section.hasAttribute('data-default-open');
          }
        }
      });
      
      matchingCount.textContent = `${matchCount} of ${cards.length} matching`;
    }
    
    searchInput.addEventListener('input', runSearch);
    
    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      runSearch();
      searchInput.focus();
    });
    
    // Highlight card with Reflow animation flash
    function highlightCard(hash) {
      if (!hash) return;
      const targetCard = document.querySelector(hash);
      if (targetCard && targetCard.classList.contains('glossary-card')) {
        // Open the containing accordion so the target card is visible
        const accordion = targetCard.closest('details.class-accordion');
        if (accordion) accordion.open = true;

        cards.forEach(c => c.classList.remove('flash-active'));
        void targetCard.offsetWidth; // force reflow
        targetCard.classList.add('flash-active');
        
        // Scroll target card to center of viewport
        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
    
    // Listen for click on index links
    indexLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const hash = link.getAttribute('href');
        highlightCard(hash);
        
        // Close index panel on mobile
        if (window.innerWidth < 768 && indexContainer) {
          indexContainer.removeAttribute('open');
        }
      });
    });
    
    // Check initial hash
    if (window.location.hash) {
      setTimeout(() => {
        highlightCard(window.location.hash);
      }, 300);
    }
  });
</script>

<style>
  .glossary-header {
    margin-bottom: 2rem;
  }
  
  .glossary-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent);
  }

  /* Translucent Sticky Control Panel */
  .glossary-controls-sticky {
    position: sticky;
    top: 3.5rem;
    z-index: 40;
    margin-bottom: 2.5rem;
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    background: rgba(243, 239, 230, 0.85); /* Translucent surface */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    box-shadow: 0 4px 20px var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  [data-theme="dark"] .glossary-controls-sticky {
    background: rgba(36, 32, 25, 0.85);
    border-color: var(--border-light);
  }

  @media (min-width: 768px) {
    .glossary-controls-sticky {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  .search-wrapper {
    position: relative;
    flex: 1;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.65rem 2.5rem 0.65rem 2.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-muted);
  }

  .search-clear {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.15rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .search-clear:hover {
    background: var(--border-light);
    color: var(--text);
  }

  .controls-right {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .matching-count {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  /* Segmented control script toggle */
  .script-toggle-segmented {
    display: flex;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.1875rem;
  }

  .script-toggle-btn {
    padding: 0.4rem 1rem;
    border-radius: 6px;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: all 0.25s ease;
    user-select: none;
  }

  .script-toggle-btn:hover:not(.active) {
    color: var(--text);
  }

  .script-toggle-btn.active {
    background: var(--accent);
    color: #ffffff;
  }

  [data-theme="dark"] .script-toggle-btn.active {
    color: #1a1712;
  }

  /* Collapsible Index Pill Cloud */
  .glossary-index-container {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-surface);
    overflow: hidden;
    margin-bottom: 2.5rem;
    box-shadow: 0 2px 10px var(--shadow);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .glossary-index-container summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 1.25rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .glossary-index-container summary::-webkit-details-marker {
    display: none;
  }

  .summary-title {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .details-chevron {
    transition: transform 0.25s ease;
    color: var(--text-secondary);
  }

  .glossary-index-container[open] .details-chevron {
    transform: rotate(180deg);
  }

  .index-content {
    border-top: 1px solid var(--border);
    padding: 1.25rem;
    background: var(--bg);
  }

  .glossary-index-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .glossary-index-link {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .glossary-index-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-muted);
    text-decoration: none;
  }

  /* Section Title and Date styling */
  .glossary-section {
    margin-bottom: 4rem;
  }

  /* Collapsible class accordion */
  .class-accordion {
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--bg-surface);
  }

  .class-accordion__header {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.85rem;
    padding: 1.1rem 1.35rem;
    font-family: var(--font-body);
    background-color: var(--bg-surface-alt, var(--bg-surface));
    transition: background-color 0.15s ease;
  }

  .class-accordion__header::-webkit-details-marker { display: none; }
  .class-accordion__header:hover { background-color: var(--border-light); }

  .class-accordion[open] .class-accordion__header {
    border-bottom: 1px solid var(--border-light);
  }

  .accordion-class {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
  }

  .accordion-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .term-count {
    margin-left: auto;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .class-accordion__body {
    padding: 2rem 1.35rem 2.5rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
    border-bottom: 2px solid var(--border-light);
    padding-bottom: 0.5rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (min-width: 640px) {
    .section-title {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
    }
  }

  .section-date {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--text-secondary);
    font-family: var(--font-body);
  }

  /* Cards Grid */
  .cards-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 760px; /* Enforces premium centered max width */
    margin: 0 auto;
  }

  /* Premium Card Design */
  .glossary-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    box-shadow: 0 4px 15px var(--shadow);
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.2s ease, box-shadow 0.2s ease;
