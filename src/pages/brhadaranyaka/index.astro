---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { BRAHMANAS, mantrasCovered } from '../../lib/brahmanas';

const allClasses = await getCollection('classes');
// Only IAST versions for counting (avoid duplicates)
const iastClasses = allClasses.filter(c => c.data.series === 'brhadaranyaka' && c.data.script === 'iast');

// One card per brāhmaṇa, the one currently being taught first
const cards = BRAHMANAS
  .map(b => {
    const classes = iastClasses.filter(c => c.data.adhyaya === b.adhyaya && c.data.brahmana === b.brahmana);
    const covered = mantrasCovered(b, classes);
    return {
      ...b,
      count: classes.length,
      latestDate: classes.map(c => c.data.date).sort().reverse()[0] || '',
      covered,
      complete: covered === b.mantraCount,
    };
  })
  .filter(b => b.count > 0)
  .sort((a, b) => b.adhyaya - a.adhyaya || b.brahmana - a.brahmana);

function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title="Bṛhadāraṇyaka Upaniṣad"
  description="Class notes on the Bṛhadāraṇyaka Upaniṣad with Śāṅkara Bhāṣya — organized by adhyāya and brāhmaṇa."
>
  <div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
    <Breadcrumb items={[
      { label: 'Home', href: `${import.meta.env.BASE_URL}/` },
      { label: 'Bṛhadāraṇyaka Upaniṣad' },
    ]} />

    <h1>Bṛhadāraṇyaka Upaniṣad</h1>
    <p class="meta" style="margin-bottom: 0.5rem; font-style: italic;">
      with Śāṅkara Bhāṣya
    </p>

    <p style="margin-bottom: 0.75rem;">
      The Bṛhadāraṇyaka Upaniṣad is the largest and among the most important of the principal Upaniṣads. Belonging to the Śukla Yajurveda, it forms the concluding portion (āraṇyaka) of the Śatapatha Brāhmaṇa. The text is studied here with Śrī Śaṅkarācārya's bhāṣya, supplemented by Sureśvarācārya's Vārttika, as taught by <strong>Pūjya Swami Shankarananda</strong>.
    </p>
    <p style="margin-bottom: 0.75rem; font-size: 0.9375rem;">
      {cards.map(b => (
        <><a href={b.playlistUrl} target="_blank" rel="noopener noreferrer">📺 {b.name} Playlist</a> · </>
      ))}
      <a href="https://drive.google.com/drive/folders/1GsnyvVftBlBqhcu36YtXgnGkHRYGroFA" target="_blank" rel="noopener noreferrer">📄 Class Materials (Google Drive)</a>
    </p>
    <p style="margin-bottom: 2rem; font-size: 0.875rem; color: var(--text-secondary);">
      <strong style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-tertiary);">Source Texts (Advaita Sharada)</strong><br>
      <a href="https://advaitasharada.sringeri.net/display/bhashya/Brha/devanagari" target="_blank" rel="noopener noreferrer">Śāṅkara Bhāṣya</a> ·
      <a href="https://advaitasharada.sringeri.net/display/vyakhya/brihadaranyakabhashya-vartika/devanagari" target="_blank" rel="noopener noreferrer">Sureśvara Vārttika</a> ·
      <a href="https://advaitasharada.sringeri.net/display/vyakhya/anandagiri-Brha/devanagari" target="_blank" rel="noopener noreferrer">Ānandagiri Ṭīkā</a> ·
      <a href="https://advaitasharada.sringeri.net/ग्रन्थाः/" target="_blank" rel="noopener noreferrer">All Śruti Texts</a>
    </p>

    <h2 class="tree__heading" style="margin-top: 0.5rem;">Adhyāya 2</h2>
    <div class="brahmana-cards" style="display: grid; gap: 1rem; margin-top: 1rem;">
      {cards.map(b => (
        <a href={`${import.meta.env.BASE_URL}/brhadaranyaka/${b.key}/`} class="series-card" id={`brahmana-${b.key}`}>
          <div class="series-card__title">{b.adhyaya}.{b.brahmana} — {b.name}</div>
          <div class="series-card__subtitle" lang="sa">{b.nameDeva}</div>
          <div class="series-card__meta">
            {b.count} {b.count === 1 ? 'class' : 'classes'}
            {b.complete
              ? ` · Complete — all ${b.mantraCount} mantras`
              : b.covered
                ? ` · In progress — mantras ${b.adhyaya}.${b.brahmana}.1–${b.adhyaya}.${b.brahmana}.${b.covered} of ${b.mantraCount}`
                : ' · In progress'}
            {b.latestDate && ` · Latest: ${formatDate(b.latestDate)}`}
          </div>
          <div class="series-card__arrow">Open classes →</div>
        </a>
      ))}
    </div>

    <script is:inline>
      // Old links pointed at #class-2-4-N on this page; the class lists now live
      // on one page per brāhmaṇa, so forward those anchors there.
      (function () {
        var m = location.hash.match(/^#class-(\d+)-(\d+)-(\d+)$/);
        if (m) location.replace(location.pathname.replace(/\/?$/, '/') + m[1] + '-' + m[2] + '/' + location.hash);
      })();
    </script>
  </div>
</BaseLayout>
