---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ClassNav from '../../components/ClassNav.astro';
import SourceTextFloat from '../../components/SourceTextFloat.astro';
import { getCollection, render } from 'astro:content';

// Generate all class page routes
export async function getStaticPaths() {
  const allClasses = await getCollection('classes');

  // Group by series/adhyaya/brahmana/class_number to pair dev+iast
  const classMap = new Map<string, { dev?: any; iast?: any }>();

  for (const cls of allClasses) {
    const key = `${cls.data.series}/${cls.data.adhyaya}-${cls.data.brahmana}/class-${String(cls.data.class_number).padStart(2, '0')}`;
    if (!classMap.has(key)) {
      classMap.set(key, {});
    }
    const pair = classMap.get(key)!;
    if (cls.data.script === 'devanagari') pair.dev = cls;
    if (cls.data.script === 'iast') pair.iast = cls;
  }

  // Get all IAST classes sorted for prev/next navigation
  const iastClasses = allClasses
    .filter(c => c.data.script === 'iast')
    .sort((a, b) => {
      if (a.data.series !== b.data.series) return a.data.series.localeCompare(b.data.series);
      if (a.data.adhyaya !== b.data.adhyaya) return a.data.adhyaya - b.data.adhyaya;
      if (a.data.brahmana !== b.data.brahmana) return a.data.brahmana - b.data.brahmana;
      return a.data.class_number - b.data.class_number;
    });

  const paths = [];

  for (const [key, pair] of classMap.entries()) {
    if (!pair.iast) continue;
    const cls = pair.iast;
    const slug = `${cls.data.adhyaya}-${cls.data.brahmana}/class-${String(cls.data.class_number).padStart(2, '0')}`;

    // Find prev/next in the same series
    const seriesClasses = iastClasses.filter(c => c.data.series === cls.data.series);
    const idx = seriesClasses.findIndex(
      c => c.data.adhyaya === cls.data.adhyaya &&
           c.data.brahmana === cls.data.brahmana &&
           c.data.class_number === cls.data.class_number
    );

    const prev = idx > 0 ? seriesClasses[idx - 1] : null;
    const next = idx < seriesClasses.length - 1 ? seriesClasses[idx + 1] : null;

    paths.push({
      params: { slug },
      props: {
        devEntry: pair.dev || null,
        iastEntry: pair.iast,
        prevClass: prev,
        nextClass: next,
      },
    });
  }

  return paths;
}

const { devEntry, iastEntry, prevClass, nextClass } = Astro.props;
const data = iastEntry.data;

// Render markdown content
const { Content: IastContent } = await render(iastEntry);
const devResult = devEntry ? await render(devEntry) : null;
const DevContent = devResult?.Content ?? null;

// Calculate course progress
const allClasses = await getCollection('classes');
const seriesClasses = allClasses
  .filter(c => c.data.script === 'iast' && c.data.series === data.series)
  .sort((a, b) => {
    if (a.data.adhyaya !== b.data.adhyaya) return a.data.adhyaya - b.data.adhyaya;
    if (a.data.brahmana !== b.data.brahmana) return a.data.brahmana - b.data.brahmana;
    return a.data.class_number - b.data.class_number;
  });
const currentIdx = seriesClasses.findIndex(
  c => c.data.adhyaya === data.adhyaya &&
       c.data.brahmana === data.brahmana &&
       c.data.class_number === data.class_number
);
const totalClasses = seriesClasses.length;
const progressPercent = totalClasses > 0 ? Math.round(((currentIdx + 1) / totalClasses) * 100) : 0;

function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
}

function classUrl(cls: any) {
  return `${import.meta.env.BASE_URL}/brhadaranyaka/${cls.data.adhyaya}-${cls.data.brahmana}/class-${String(cls.data.class_number).padStart(2, '0')}/`;
}

function extractVideoId(url: string) {
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes('youtu.be')) return parsed.pathname.replace('/', '');
    return parsed.searchParams.get('v') || '';
  } catch {
    const match = url.match(/(?:v=|youtu\.be\/|embed\/)([A-Za-z0-9_-]{6,})/);
    return match?.[1] || '';
  }
}

function usableAudioUrl(url?: string) {
  if (!url) return '';
  if (url.startsWith('INTERNET_ARCHIVE') || url.startsWith('PENDING_INTERNET_ARCHIVE')) return '';
  if (url.startsWith('/')) return `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${url.replace(/^\//, '')}`;
  return url;
}

const prevLink = prevClass ? { label: `Class ${prevClass.data.class_number}`, href: classUrl(prevClass) } : undefined;
const nextLink = nextClass ? { label: `Class ${nextClass.data.class_number}`, href: classUrl(nextClass) } : undefined;
const canonicalURL = new URL(`${import.meta.env.BASE_URL}/brhadaranyaka/${data.adhyaya}-${data.brahmana}/class-${String(data.class_number).padStart(2, '0')}/`, Astro.site || Astro.url.origin).toString();
const classMetaTitle = `${data.brahmana_name} — Class ${data.class_number} | Vedāntic Study Archive`;
const audioUrl = usableAudioUrl(data.audio_url);
const videoId = data.video_url ? extractVideoId(data.video_url) : '';
---

<BaseLayout
  title={`${data.brahmana_name} — Class ${data.class_number}`}
  description={data.coverage}
  canonicalURL={canonicalURL}
  ogTitle={classMetaTitle}
  ogDescription={data.coverage}
  ogType="article"
  ogUrl={canonicalURL}
>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <article class="container" style="padding-top: 2rem; padding-bottom: 2rem;" data-pagefind-body>
    <Breadcrumb items={[
      { label: 'Home', href: `${import.meta.env.BASE_URL}/` },
      { label: 'Bṛhadāraṇyaka', href: `${import.meta.env.BASE_URL}/brhadaranyaka/` },
      { label: `${data.adhyaya}.${data.brahmana} ${data.brahmana_name}`, href: `${import.meta.env.BASE_URL}/brhadaranyaka/#class-${data.adhyaya}-${data.brahmana}-1` },
      { label: `Class ${data.class_number}` },
    ]} />

    <!-- Class Header -->
    <header class="class-header">
      <div class="class-header__series" data-pagefind-meta="series">{data.series_title}</div>
      <h1 class="class-header__title">
        {data.brahmana_name} ({data.adhyaya}.{data.brahmana}) — Class {data.class_number}
      </h1>
      <div class="class-header__date" data-pagefind-meta="date">{formatDate(data.date)}</div>
      
      <!-- Class Progress Bar -->
      <div class="class-progress" style="margin-top: 0.5rem; margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 0.25rem; font-family: var(--font-ui);">
          <span>Class progress</span>
          <span>{currentIdx + 1} / {totalClasses} ({progressPercent}%)</span>
        </div>
        <div style="width: 100%; height: 4px; background-color: var(--border-light); border-radius: 2px; overflow: hidden;">
          <div style={`width: ${progressPercent}%; height: 100%; background-color: var(--accent); transition: width 0.3s ease;`}></div>
        </div>
      </div>

      <div class="class-header__coverage">
        <strong style="font-size: 0.8125rem; font-family: var(--font-ui); text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-tertiary);">Coverage</strong><br>
        {data.coverage}
      </div>
      
      <!-- Metadata Block -->
      <div class="class-metadata" style="margin-top: 1.5rem; border-top: 1px solid var(--border-light); padding-top: 0.75rem; display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.75rem; color: var(--text-tertiary);">
        <div><strong>Status:</strong> Audio-reviewed and Editor-corrected</div>
        <div><strong>Version:</strong> 1.0</div>
        <div><a href={`mailto:nistala.aditya@gmail.com?subject=Corrections - Vedāntic Study Archive - ${data.brahmana_name} Class ${data.class_number}`} style="color: inherit; text-decoration: underline;">Report Error / Feedback</a></div>
      </div>
    </header>

    <!-- Audio Player -->
    {audioUrl && (
      <div class="audio-player" style="margin-top: 1.5rem; margin-bottom: 1.5rem; background: var(--surface-2); padding: 1rem; border-radius: 8px;">
        <strong style="display: block; margin-bottom: 0.5rem; font-size: 0.875rem;">Listen to Class Audio</strong>
        <audio controls src={audioUrl} style="width: 100%;">
          Your browser does not support the audio element.
        </audio>
      </div>
    )}

    {videoId && (
      <details class="accordion video-accordion" style="margin-bottom: 2rem; border: 1px solid var(--border-light); border-radius: 8px; overflow: hidden;">
        <summary style="font-weight: 600; padding: 1rem; background: var(--bg-surface); cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none;">
          <span style="font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem; color: var(--text-secondary);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent);"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            Watch Class Video (Optional)
          </span>
          <span class="accordion-icon" style="transition: transform 0.2s ease; font-size: 0.75rem; color: var(--text-tertiary);">▼</span>
        </summary>
        <div style="padding: 1rem; background: var(--bg);">
          <div style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden; border-radius:4px;">
            <iframe
              src={`https://www.youtube.com/embed/${videoId}`}
              style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          </div>
        </div>
      </details>
    )}

    <!-- Script Toggle -->
    <div class="script-toggle" role="tablist" aria-label="Script selection">
      <button
        class="script-toggle__btn is-active"
        role="tab"
        aria-selected="true"
        aria-controls="panel-iast"
        id="tab-iast"
        data-script="iast"
      >
        IAST
      </button>
      {DevContent && (
        <button
          class="script-toggle__btn"
          role="tab"
          aria-selected="false"
          aria-controls="panel-devanagari"
          id="tab-devanagari"
          data-script="devanagari"
        >
          Devanagari
        </button>
      )}
    </div>

    <!-- IAST Panel -->
    <div
      class="script-panel is-visible"
      id="panel-iast"
      role="tabpanel"
      aria-labelledby="tab-iast"
      data-script-label="IAST Version"
    >
      {(iastEntry.data.source_ref || iastEntry.data.related_verses) && (
        <details class="accordion source-accordion" style="margin-bottom: 2rem;">
          <summary style="font-weight: 600; padding: 1rem; background: var(--surface-2); cursor: pointer; border-radius: 4px;">Source Text Covered in This Class</summary>
          <div class="accordion-content" style="padding: 1rem; border: 1px solid var(--surface-2); border-top: none;">
            <p style="margin-bottom: 1rem; color: var(--text-secondary);"><strong>Primary source:</strong> {iastEntry.data.source_ref}</p>
            
            {iastEntry.data.source_text_content && (
              <div class="source-text-block" style="background: var(--surface-1); border: 1px solid var(--border-color); padding: 1.5rem; border-left: 4px solid var(--primary-color); border-radius: 4px; font-size: 1.1rem; line-height: 1.8;">
                <div set:html={iastEntry.data.source_text_content} />
              </div>
            )}
            {iastEntry.data.related_verses && (
              <p style="margin-top: 1rem; color: var(--text-secondary);"><strong>Related verses:</strong> {iastEntry.data.related_verses}</p>
            )}
          </div>
        </details>
      )}
      <div class="class-body">
        <IastContent />
      </div>
    </div>

    <!-- Devanagari Panel -->
    {DevContent && (
      <div
        class="script-panel devanagari"
        id="panel-devanagari"
        role="tabpanel"
        aria-labelledby="tab-devanagari"
        data-script-label="Devanagari Version"
        lang="sa"
      >
        {(devEntry.data.source_ref || devEntry.data.related_verses) && (
          <details class="accordion source-accordion" style="margin-bottom: 2rem;">
            <summary style="font-weight: 600; padding: 1rem; background: var(--surface-2); cursor: pointer; border-radius: 4px;">Source Text Covered in This Class</summary>
            <div class="accordion-content" style="padding: 1rem; border: 1px solid var(--surface-2); border-top: none;">
              <p style="margin-bottom: 1rem; color: var(--text-secondary);"><strong>Primary source:</strong> {devEntry.data.source_ref}</p>
              
              {devEntry.data.source_text_content && (
                <div class="source-text-block" style="background: var(--surface-1); border: 1px solid var(--border-color); padding: 1.5rem; border-left: 4px solid var(--primary-color); border-radius: 4px; font-size: 1.1rem; line-height: 1.8;">
                  <div set:html={devEntry.data.source_text_content} />
                </div>
              )}
              {devEntry.data.related_verses && (
                <p style="margin-top: 1rem; color: var(--text-secondary);"><strong>Related verses:</strong> {devEntry.data.related_verses}</p>
              )}
            </div>
          </details>
        )}
        <div class="class-body">
          <DevContent />
        </div>
      </div>
    )}


    <!-- Prev/Next Navigation -->
    <ClassNav
      prev={prevLink}
      next={nextLink}
      backLabel={`${data.adhyaya}.${data.brahmana} ${data.brahmana_name}`}
      backHref={`${import.meta.env.BASE_URL}/brhadaranyaka/`}
      audioUrl={data.video_url || audioUrl || undefined}
    />

    <SourceTextFloat
      iastSourceText={iastEntry.data.source_text_content}
      devSourceText={devEntry?.data.source_text_content}
    />

    <!-- Last updated -->
    <p class="text-xs" style="text-align: center; margin-top: 1.5rem;">
      Last updated: {new Date().toISOString().split('T')[0]}
    </p>
  </article>

  <script>
    // Script toggle
    function initScriptToggle() {
      const tabs = document.querySelectorAll('.script-toggle__btn');
      const panels = document.querySelectorAll('.script-panel');

      // Restore preference
      const savedScript = localStorage.getItem('preferred-script') || 'iast';
      setActiveScript(savedScript);

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const script = (tab as HTMLElement).dataset.script;
          if (script) {
            setActiveScript(script);
            localStorage.setItem('preferred-script', script);
          }
        });
      });

      function setActiveScript(script: string) {
        const scrollY = window.scrollY;

        tabs.forEach(tab => {
          const isActive = (tab as HTMLElement).dataset.script === script;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', String(isActive));
        });

        panels.forEach(panel => {
          const panelScript = panel.id.replace('panel-', '');
          panel.classList.toggle('is-visible', panelScript === script);
        });

        // Preserve scroll position
        requestAnimationFrame(() => window.scrollTo(0, scrollY));
      }
    }

    function processClassBody() {
      // The invocation always ends with one of these markers:
      const INVOC_END_IAST = [
        'namo gurubhyaḥ ||',
        'namo gurubhyaḥ',
        'gurubhyaḥ ||',
        'gurubhyaḥ',
      ];
      const INVOC_END_DEV = [
        'नमो गुरुभ्यः॥',
        'नमो गुरुभ्यः ।।',
        'गुरुभ्यः॥',
        'गुरुभ्यः ।।',
        'गुरुभ्यः',
      ];

      // Helper: split a paragraph element into multiple elements
      // at a text split point, inserting them in place
      function splitParagraphAt(para, splitAfterText) {
        const html = para.innerHTML;
        const idx = html.indexOf(splitAfterText);
        if (idx === -1) return false;

        const invocHTML = html.substring(0, idx + splitAfterText.length).trim();
        let teachHTML = html.substring(idx + splitAfterText.length).trim();
        // Remove leading pipes/dandas/spaces
        teachHTML = teachHTML.replace(/^[\s|।॥]+/, '').trim();
        if (!invocHTML || !teachHTML) return false;

        // Build invocation block
        const invocDiv = document.createElement('div');
        invocDiv.className = 'invocation-block';
        const verses = invocHTML.split(/\s*\|\|\s*/);
        verses.forEach((verse) => {
          const v = verse.trim();
          if (!v) return;
          const span = document.createElement('span');
          span.className = 'invocation-verse';
          span.textContent = v;
          invocDiv.appendChild(span);
        });

        // Build separator
        const hr = document.createElement('hr');
        hr.className = 'invocation-separator';

        // Build teaching paragraph
        const teachPara = document.createElement('p');
        teachPara.innerHTML = teachHTML;

        // Replace original element
        para.replaceWith(invocDiv, hr, teachPara);
        return true;
      }

      // Helper: split long paragraph at natural break points
      // Returns array of new paragraphs
      function smartSplit(para) {
        if (para.textContent.length < 450) return;
        if (para.closest('.invocation-block') ||
            para.classList.contains('closing-verse-block')) return;

        let html = para.innerHTML;
        const original = html;

        // Mark break points with a sentinel string
        const SENTINEL = '|||PARABREAK|||';

        // Break after "Okay." or "Okay?" at end of a point
        html = html.replace(/(\bOkay\s*\.)\s+(?=[A-Z\u0900-\u097F\*])/g,
          '$1 ' + SENTINEL);
        html = html.replace(/(\bOkay\s*\?)\s+(?=[A-Z\u0900-\u097F\*])/g,
          '$1 ' + SENTINEL);
        // Break after "Alright." / "Alright?"
        html = html.replace(/(\bAlright\s*[.?])\s+(?=[A-Z\*])/g,
          '$1 ' + SENTINEL);
        // Break before strong transition phrases at sentence start
        html = html.replace(/\.\s+(So now[,\s])/g, '. ' + SENTINEL + '$1');
        html = html.replace(/\.\s+(Now,\s)/g, '. ' + SENTINEL + '$1');
        html = html.replace(/\.\s+(Coming back\s)/g, '. ' + SENTINEL + '$1');
        html = html.replace(/\.\s+(Let me\s)/g, '. ' + SENTINEL + '$1');
        html = html.replace(/\.\s+(Let us\s)/g, '. ' + SENTINEL + '$1');
        html = html.replace(/\.\s+(Therefore,\s)/g, '. ' + SENTINEL + '$1');
        html = html.replace(/\.\s+(This is why\s)/g, '. ' + SENTINEL + '$1');

        if (html === original) return; // no breaks found

        const parts = html.split(SENTINEL).filter(p => p.trim());
        if (parts.length < 2) return;

        const fragment = document.createDocumentFragment();
        parts.forEach(part => {
          const np = document.createElement('p');
          np.innerHTML = part.trim();
          fragment.appendChild(np);
        });
        para.parentNode.replaceChild(fragment, para);
      }

      // Process each class-body panel
      document.querySelectorAll('.class-body').forEach(body => {
        // ── 1. OPENING INVOCATION ───────────────────────────────────────
        const firstPara = body.querySelector('p');
        if (firstPara) {
          const text = firstPara.textContent.trim();
          const startsOM = text.startsWith('oṃ') ||
                           text.startsWith('ॐ') ||
                           text.toLowerCase().startsWith('om ');

          if (startsOM) {
            // Try each possible end marker
            let found = false;
            const markers = [...INVOC_END_IAST, ...INVOC_END_DEV];
            for (const marker of markers) {
              if (firstPara.innerHTML.includes(marker)) {
                found = splitParagraphAt(firstPara, marker);
                if (found) break;
              }
            }

            // Fallback: if no marker found but para has || and English after,
            // split at last || sequence before an English capital letter
            if (!found && text.includes('||')) {
              const html = firstPara.innerHTML;
              // Find last || before English text
              const matches = [...html.matchAll(/\|\|/g)];
              if (matches.length > 0) {
                const lastMatch = matches[matches.length - 1];
                const afterPipes = html.substring(lastMatch.index + 2);
                if (/^\s*[A-Z]/.test(afterPipes)) {
                  splitParagraphAt(firstPara, '||' + html.substring(
                    lastMatch.index + 2,
                    lastMatch.index + 2 + afterPipes.search(/[A-Z]/)));
                }
              }
            }
          }
        }

        // ── 2. CLOSING VERSE ────────────────────────────────────────────
        const allP = Array.from(body.querySelectorAll('p'));
        const closingMarkers = [
          'pūrṇamadaḥ', 'पूर्णमदः',
          'hariḥ oṃ', 'हरिः ॐ',
        ];
        allP.slice(-5).forEach(p => {
          const t = p.textContent;
          if (closingMarkers.some(m => t.includes(m)) &&
              !p.closest('.invocation-block')) {
            p.classList.add('closing-verse-block');
            // Format verses: split by || onto separate lines
            const parts = p.innerHTML.split(/\s*\|\|\s*/);
            if (parts.length > 1) {
              p.innerHTML = parts.filter(v => v.trim())
                .map(v => '<span class="invocation-verse">' + v.trim() + '</span>')
                .join('');
            }
          }
        });

        // ── 3. SMART PARAGRAPH BREAKS ───────────────────────────────────
        // Run on ALL paragraphs (snapshot first to avoid mutation issues)
        Array.from(body.querySelectorAll('p')).forEach(p => {
          smartSplit(p);
        });
      });
    }

    // ── Run after DOM and after every script-toggle click ──────────────
    function runOnceReady() {
      initScriptToggle();

      const progress = document.getElementById('reading-progress');
      if (progress) {
        const updateProgress = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const pct = max > 0 ? (doc.scrollTop / max) * 100 : 0;
          progress.style.width = `${Math.min(100, Math.max(0, pct))}%`;
        };
        updateProgress();
        document.addEventListener('scroll', updateProgress, { passive: true });
      }

      processClassBody();
      
      document.querySelectorAll('.script-toggle__btn').forEach(btn => {
        btn.addEventListener('click', () => {
          setTimeout(processClassBody, 80);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runOnceReady);
    } else {
      runOnceReady();
    }
  </script>
</BaseLayout>
