---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// Read the markdown glossary file
const glossaryPath = path.resolve('./src/content/glossary/brhad_upa_maitreyi_brahmana_glossary_classwise.md');
const rawGlossary = fs.readFileSync(glossaryPath, 'utf-8');

// Get all class metadata to pull dates dynamically
const allClasses = await getCollection('classes');
const classDates = {};
allClasses.forEach(c => {
  if (c.data.script === 'iast') {
    classDates[c.data.class_number] = c.data.date;
  }
});

// Helper function to format basic inline markdown formatting into HTML
function formatMarkdown(text: string) {
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/_(.*?)_/g, '<em>$1</em>')
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2">$1</a>');
}

// Parse glossary sections
const parts = rawGlossary.split(/^##\s+/m);
const rawSections = parts.slice(1);

const parsedSections = rawSections.map((sectText) => {
  const lines = sectText.split('\n');
  const rawTitle = lines[0].trim();
  
  let classNumber = null;
  let sectionTitle = rawTitle;
  
  // Format title e.g. "Class 1 — Introduction to the Maitreyī Brāhmaṇa and the Vidyāsūtra"
  // or "Consolidated Core Glossary for Site-Wide Use"
  const classMatch = rawTitle.match(/^Class\s+(\d+)/i);
  if (classMatch) {
    classNumber = parseInt(classMatch[1], 10);
    // Strip "Class 1 — " from the sectionTitle
    sectionTitle = rawTitle.replace(/^Class\s+\d+\s*[-—]\s*/i, '');
  }

  const terms = [];
  let currentTerm = null;

  for (let i = 1; i < lines.length; i++) {
    const line = lines[i].trim();
    if (!line) continue;

    const termMatch = line.match(/^\*\*(.*?)\*\*/);
    if (termMatch) {
      currentTerm = termMatch[1];
    } else if (line.startsWith(':') && currentTerm) {
      const definition = line.substring(1).trim();
      terms.push([currentTerm, formatMarkdown(definition)]);
      currentTerm = null;
    }
  }

  return {
    rawTitle,
    sectionTitle,
    classNumber,
    terms
  };
});

const classSections = parsedSections.filter(s => s.classNumber !== null);
const coreSection = parsedSections.find(s => s.classNumber === null);

// Generate consolidated terms list sorted alphabetically
const terms = classSections
  .flatMap(section => 
    section.terms.map(term => ({ 
      term: term[0], 
      classNumber: section.classNumber 
    }))
  )
  .sort((a, b) => a.term.localeCompare(b.term));

function slug(term: string, classNumber: number) {
  return `class-${classNumber}-${term.toLowerCase().replace(/[^a-z0-9āīūṛṝḷṅñṭḍṇśṣṃḥ]+/g, '-')}`;
}
---

<BaseLayout title="Glossary" description="Sanskrit terms explained in the class notes, organised by class.">
  <div class="container container--wide page-pad">
    <h1>Glossary</h1>

    <details class="glossary-index-container" style="margin: 1.5rem 0 2.5rem; border: 1px solid var(--border-light); border-radius: 8px; background: var(--bg-surface); overflow: hidden;">
      <summary style="display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1.25rem; font-family: var(--font-ui); font-size: 0.9rem; font-weight: 600; color: var(--accent); cursor: pointer; user-select: none; list-style: none;">
        <span style="display: inline-flex; align-items: center; gap: 0.5rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          Browse All Terms ({terms.length})
        </span>
        <svg class="details-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.2s ease;"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div style="border-top: 1px solid var(--border-light); padding: 1.25rem; background: var(--bg);">
        <div class="glossary-index" style="margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem;">
          {terms.map(item => <a href={`#${slug(item.term, item.classNumber)}`}>{item.term}</a>)}
        </div>
      </div>
    </details>

    {classSections.map(section => (
      <section class="glossary-section">
        <h2>Class {section.classNumber} — {section.sectionTitle} {classDates[section.classNumber] ? `(${classDates[section.classNumber]})` : ''}</h2>
        {section.terms.map(term => (
          <article class="glossary-term" id={slug(term[0], section.classNumber)}>
            <h3>{term[0]}</h3>
            <p set:html={term[1]} />
            <p class="meta">Class {section.classNumber}</p>
          </article>
        ))}
      </section>
    ))}

    {coreSection && coreSection.terms.length > 0 && (
      <section class="glossary-section">
        <h2>{coreSection.sectionTitle}</h2>
        {coreSection.terms.map(term => (
          <article class="glossary-term" id={`core-${term[0].toLowerCase().replace(/[^a-z0-9āīūṛṝḷṅñṭḍṇśṣṃḥ]+/g, '-')}`}>
            <h3>{term[0]}</h3>
            <p set:html={term[1]} />
            <p class="meta">Core Term</p>
          </article>
        ))}
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .glossary-index-container summary::-webkit-details-marker {
    display: none;
  }
  .glossary-index-container summary {
    list-style: none;
  }
  .glossary-index-container[open] .details-chevron {
    transform: rotate(180deg);
  }
</style>

