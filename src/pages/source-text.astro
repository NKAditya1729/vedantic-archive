---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allClasses = await getCollection('classes');
const iastClasses = allClasses
  .filter(c => c.data.series === 'brhadaranyaka' && c.data.script === 'iast')
  .sort((a, b) => a.data.class_number - b.data.class_number);
const devClasses = allClasses
  .filter(c => c.data.series === 'brhadaranyaka' && c.data.script === 'devanagari')
  .sort((a, b) => a.data.class_number - b.data.class_number);
const latest = iastClasses[iastClasses.length - 1];
---

<BaseLayout title="Source Text Covered" description="Source text covered in the Maitreyī Brāhmaṇa classes so far.">
  <div class="container container--wide page-pad">
    <h1>Source Text Covered — Maitreyī Brāhmaṇa (2.4)</h1>
    <p class="meta">Bṛhadāraṇyaka Upaniṣad with Śāṅkara Bhāṣya and Sureśvara Vārtika</p>
    {latest && <p>This page reflects text covered through Class {latest.data.class_number}. Last updated: {latest.data.date}.</p>}

    <div class="script-toggle" role="tablist" aria-label="Script selection">
      <button class="script-toggle__btn is-active" role="tab" aria-selected="true" aria-controls="source-iast" id="source-tab-iast" data-script="iast">IAST</button>
      <button class="script-toggle__btn" role="tab" aria-selected="false" aria-controls="source-devanagari" id="source-tab-devanagari" data-script="devanagari">Devanagari</button>
    </div>

    <!-- Scoped style to hide class boundary/ref lines -->
    <style is:global>
      .source-class-container .source-ref-line {
        display: none !important;
      }
    </style>

    <div class="source-class-container">
      <section class="script-panel is-visible" id="source-iast" role="tabpanel" aria-labelledby="source-tab-iast">
        <div style="display:flex;flex-wrap:wrap;gap:1.25rem;
          padding:0.75rem 1rem;background:var(--surface-2);
          border-radius:6px;margin-bottom:1.5rem;font-size:0.8rem;
          border:1px solid var(--border-color);">
          <span><strong style="color:#1a1a1a;font-weight:700;">
            Mūlam</strong> — Upaniṣad mantra</span>
          <span><span style="color:#1a1a1a;">Bhāṣyam</span>
            — Śaṅkara's commentary</span>
          <span><span style="color:#B54510;font-weight:700;
            text-decoration:underline;">Pratīka</span>
            — mantra words in bhāṣyam</span>
          <span><span style="color:#5B1A8E;">Vārttika</span>
            — Sureśvara's verses</span>
        </div>

        {iastClasses.map(cls => (
          <div set:html={cls.data.source_text_content} />
        ))}
      </section>

      <section class="script-panel devanagari" id="source-devanagari" role="tabpanel" aria-labelledby="source-tab-devanagari" lang="sa">
        <div style="display:flex;flex-wrap:wrap;gap:1.25rem;
          padding:0.75rem 1rem;background:var(--surface-2);
          border-radius:6px;margin-bottom:1.5rem;font-size:0.8rem;
          border:1px solid var(--border-color);">
          <span><strong style="color:#1a1a1a;font-weight:700;">
            मूलम्</strong> — उपनिषद् मन्त्रः</span>
          <span><span style="color:#1a1a1a;">भाष्यम्</span>
            — शाङ्करभाष्यम्</span>
          <span><span style="color:#B54510;font-weight:700;
            text-decoration:underline;">प्रतीकः</span>
            — भाष्यगत मन्त्रपदम्</span>
          <span><span style="color:#5B1A8E;">वार्तिकम्</span>
            — सुरेश्वरवार्तिकम्</span>
        </div>

        {devClasses.map(cls => (
          <div set:html={cls.data.source_text_content} />
        ))}
      </section>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.script-toggle__btn');
      const panels = document.querySelectorAll('.script-panel');
      function setActive(script) {
        tabs.forEach(tab => {
          const active = tab.getAttribute('data-script') === script;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
        });
        panels.forEach(panel => panel.classList.toggle('is-visible', panel.id.endsWith(script)));
        localStorage.setItem('preferred-script', script);
      }
      setActive(localStorage.getItem('preferred-script') || 'iast');
      tabs.forEach(tab => tab.addEventListener('click', () => setActive(tab.getAttribute('data-script') || 'iast')));
    });
  </script>
</BaseLayout>
