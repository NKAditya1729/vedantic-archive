---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Search from '../components/Search.astro';
---

<BaseLayout
  title="Search"
  description="Search across all class notes in the Vedantic Study Archive — works with both Devanagari and IAST."
>
  <div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">
    <Breadcrumb items={[
      { label: 'Home', href: `${import.meta.env.BASE_URL}/` },
      { label: 'Search' },
    ]} />

    <div class="search-page">
      <h1>Search the Archive</h1>
      <p class="meta" style="margin-bottom: 1.5rem;">
        Search across all class notes. Both Devanagari and IAST content is indexed — try searching in either script.
      </p>
      <Search />
    </div>
  </div>
</BaseLayout>
