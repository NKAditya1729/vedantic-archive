---
import BaseLayout from '../layouts/BaseLayout.astro';
import indexData from './verse_index_data.json';

function formatClassesLabel(classes: number[]): string {
  if (classes.length === 0) return '';
  if (classes.length === 1) return `Class ${classes[0]}`;
  return `Classes ${classes[0]}–${classes[classes.length - 1]}`;
}

function classHref(classNum: number): string {
  return `${import.meta.env.BASE_URL}/brhadaranyaka/2-4/class-${String(classNum).padStart(2, '0')}/`;
}
---

<BaseLayout title="Verse Index — Maitreyī Brāhmaṇa (2.4)" description="Index of mantras and Vārtika verses covered in the class notes.">
  <div class="container container--wide page-pad" style="max-width: 900px; padding-top: 2rem; padding-bottom: 4rem;">
    <h1>Verse Index — Maitreyī Brāhmaṇa (2.4)</h1>
    <p class="meta" style="margin-bottom: 2rem;">Bṛhadāraṇyaka Upaniṣad · Śāṅkara Bhāṣya · Sureśvara Vārtika</p>

    <!-- Script Toggle -->
    <div class="script-toggle" role="tablist" aria-label="Script selection" style="margin-bottom: 2.5rem;">
      <button class="script-toggle__btn is-active" role="tab" aria-selected="true" aria-controls="index-iast" id="index-tab-iast" data-script="iast">IAST</button>
      <button class="script-toggle__btn" role="tab" aria-selected="false" aria-controls="index-devanagari" id="index-tab-devanagari" data-script="devanagari">Devanagari</button>
    </div>

    <!-- IAST Panel -->
    <section class="script-panel is-visible" id="index-iast" role="tabpanel" aria-labelledby="index-tab-iast">
      <h2 style="font-family: var(--font-ui); font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 1rem;">Mantras</h2>
      <table class="index-table">
        <thead>
          <tr>
            <th style="width: 25%;">Mantra Reference</th>
            <th style="width: 55%;">First Words</th>
            <th style="width: 20%;">Class(es)</th>
          </tr>
        </thead>
        <tbody>
          {indexData.mantras.map((item) => (
            <tr>
              <td><a href={classHref(item.classes[0])} style="color: var(--primary-color); text-decoration: none; font-weight: 500;">{item.ref}</a></td>
              <td style="font-family: var(--font-serif);">{item.first_words_iast}</td>
              <td style="font-family: var(--font-ui); color: var(--text-secondary);">{formatClassesLabel(item.classes)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2 style="font-family: var(--font-ui); font-size: 1.5rem; font-weight: 600; margin-top: 3rem; margin-bottom: 1rem;">Vārtika Verses</h2>
      <table class="index-table">
        <thead>
          <tr>
            <th style="width: 25%;">BV Reference</th>
            <th style="width: 55%;">First Words</th>
            <th style="width: 20%;">Class(es)</th>
          </tr>
        </thead>
        <tbody>
          {indexData.vartikas.map((item) => (
            <tr>
              <td><a href={classHref(item.classes[0])} style="color: var(--primary-color); text-decoration: none; font-weight: 500;">{item.ref}</a></td>
              <td style="font-family: var(--font-serif);">{item.first_words_iast}</td>
              <td style="font-family: var(--font-ui); color: var(--text-secondary);">{formatClassesLabel(item.classes)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-style: italic; font-size: 0.9rem; color: var(--text-secondary); margin-top: 1.5rem;">
        Verses 47–70 are Sureśvara's Vārtika on mantras 2.4.2–2.4.4 from the Bṛhadāraṇyaka Vārtika.
      </p>
    </section>

    <!-- Devanagari Panel -->
    <section class="script-panel devanagari" id="index-devanagari" role="tabpanel" aria-labelledby="index-tab-devanagari" lang="sa">
      <h2 style="font-family: var(--font-ui); font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 1rem;">मन्त्राः (Mantras)</h2>
      <table class="index-table">
        <thead>
          <tr>
            <th style="width: 25%;">Mantra Reference</th>
            <th style="width: 55%;">First Words</th>
            <th style="width: 20%;">Class(es)</th>
          </tr>
        </thead>
        <tbody>
          {indexData.mantras.map((item) => (
            <tr>
              <td><a href={classHref(item.classes[0])} style="color: var(--primary-color); text-decoration: none; font-weight: 500;">{item.ref}</a></td>
              <td style="font-family: 'Noto Serif Devanagari', serif; font-size: 1.05rem;">{item.first_words_dev}</td>
              <td style="font-family: var(--font-ui); color: var(--text-secondary);">{formatClassesLabel(item.classes)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2 style="font-family: var(--font-ui); font-size: 1.5rem; font-weight: 600; margin-top: 3rem; margin-bottom: 1rem;">वार्तिक-श्लोकाः (Vārtika Verses)</h2>
      <table class="index-table">
        <thead>
          <tr>
            <th style="width: 25%;">BV Reference</th>
            <th style="width: 55%;">First Words</th>
            <th style="width: 20%;">Class(es)</th>
          </tr>
        </thead>
        <tbody>
          {indexData.vartikas.map((item) => (
            <tr>
              <td><a href={classHref(item.classes[0])} style="color: var(--primary-color); text-decoration: none; font-weight: 500;">{item.ref}</a></td>
              <td style="font-family: 'Noto Serif Devanagari', serif; font-size: 1.05rem;">{item.first_words_dev}</td>
              <td style="font-family: var(--font-ui); color: var(--text-secondary);">{formatClassesLabel(item.classes)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-style: italic; font-size: 0.9rem; color: var(--text-secondary); margin-top: 1.5rem;">
        Verses 47–70 are Sureśvara's Vārtika on mantras 2.4.2–2.4.4 from the Bṛhadāraṇyaka Vārtika.
      </p>
    </section>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.script-toggle__btn');
      const panels = document.querySelectorAll('.script-panel');
      function setActive(script) {
        tabs.forEach(tab => {
          const active = tab.getAttribute('data-script') === script;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
        });
        panels.forEach(panel => panel.classList.toggle('is-visible', panel.id.endsWith(script)));
        localStorage.setItem('preferred-script', script);
      }
      setActive(localStorage.getItem('preferred-script') || 'iast');
      tabs.forEach(tab => tab.addEventListener('click', () => {
        setActive(tab.getAttribute('data-script') || 'iast');
      }));
    });
  </script>
</BaseLayout>
